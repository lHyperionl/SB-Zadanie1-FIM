[Unit]
Description=Publish the trusted daily date and Slovak namedays
After=time-sync.target

[Service]
Type=oneshot
User=fim-publisher
Group=fim-web
SupplementaryGroups=fim-read
ExecStart=/opt/fim/venv/bin/python -I -m fim publish --config /etc/fim/config.toml
WorkingDirectory=/
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# One common path: separate entries become separate mounts and rename() from
# staging to the website would fail with EXDEV. File permissions still apply.
ReadWritePaths=/var/www
RestrictAddressFamilies=AF_UNIX
MemoryMax=128M
TimeoutStartSec=30
